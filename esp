textLabelHP.TextScaled = true
textLabelHP.Font = Enum.Font.SourceSansBold
textLabelHP.Text = "100 / 100"
textLabelHP.Parent = hudFrame

local function updateHealthBar()
    local char = LocalPlayer.Character
    if not char then return end
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if not humanoid then return end

    local hp = math.clamp(humanoid.Health, 0, humanoid.MaxHealth)
    local maxHp = humanoid.MaxHealth
    local ratio = maxHp > 0 and (hp / maxHp) or 0

    fill.Size = UDim2.new(ratio, -4, 1, -4)
    textLabelHP.Text = string.format("%d / %d", math.floor(hp), math.floor(maxHp))

    if ratio > 0.75 then
        fill.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    elseif ratio > 0.50 then
        fill.BackgroundColor3 = Color3.fromRGB(255, 140, 0)
    else
        fill.BackgroundColor3 = Color3.fromRGB(255, 50, 50)
    end
end

RunService.RenderStepped:Connect(function()
    if kitAndHpEnabled then
        updateHealthBar()
    end
end)

--------------------------------------------------------------------
-- 3. PLAYER ESP (WITH ADJUSTABLE TRANSPARENCY)
--------------------------------------------------------------------
local function clearPlayerESP()
    for _, highlight in pairs(playerHighlights) do
        if highlight and highlight.Parent then
            highlight:Destroy()
        end
    end
    table.clear(playerHighlights)
end

local function applyPlayerESP(player)
    if player == LocalPlayer then return end

    if player.Team and LocalPlayer.Team and player.Team == LocalPlayer.Team then
        return
    end

    local char = player.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end

    if playerHighlights[char] then
        playerHighlights[char]:Destroy()
    end

    local highlight = Instance.new("Highlight")
    highlight.Name = "PlayerESP"
    highlight.Adornee = char
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    -- Uses live slider values
    highlight.FillTransparency = espFillTransparency
    highlight.OutlineTransparency = espOutlineTransparency

    local classVal = char:FindFirstChild("class")
    local isElite = char:FindFirstChild("elitekit")
    local teamName = player.Team and player.Team.Name:lower() or ""

    if classVal and tostring(classVal.Value):lower() == "dread" then
        highlight.FillColor = Color3.fromRGB(255, 140, 0)
    elseif isElite then
        highlight.FillColor = Color3.fromRGB(0, 255, 0)
    elseif teamName:find("empire") then
        highlight.FillColor = Color3.fromRGB(255, 50, 50)
    elseif teamName:find("nation") then
        highlight.FillColor = Color3.fromRGB(50, 150, 255)
    else
        highlight.FillColor = Color3.fromRGB(255, 0, 0)
    end

    highlight.Parent = char
    playerHighlights[char] = highlight
end

local function refreshPlayerESP()
    clearPlayerESP()
    if not playerEspEnabled then return end

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            applyPlayerESP(player)
        end
    end
end

--------------------------------------------------------------------
-- 4. SHOCK / ELITE KIT ESP
--------------------------------------------------------------------
local function clearKitESP()
    for _, adornment in pairs(kitAdornments) do
        if adornment and adornment.Parent then
            adornment:Destroy()
        end
    end
    table.clear(kitAdornments)
end

local function refreshKitESP()
    clearKitESP()
    if not kitAndHpEnabled then return end

    for _, desc in ipairs(Workspace:GetDescendants()) do
        if desc:IsA("BillboardGui") and desc.Name == "eliteicon" then
            local parentPart = desc.Parent
            if parentPart and parentPart:IsA("BasePart") then
                local box = Instance.new("BoxHandleAdornment")
                box.Name = "KitESP"
                box.Adornee = parentPart
                box.Size = parentPart.Size + Vector3.new(0.2, 0.2, 0.2)
                box.AlwaysOnTop = true
                box.ZIndex = 5
                box.Transparency = 0.4

                if parentPart.Name:lower():find("_kit1") or desc.Parent.Name:lower():find("_kit1") then
                    box.Color3 = Color3.fromRGB(0, 255, 0)
                else
                    box.Color3 = Color3.fromRGB(170, 0, 255)
                end

                box.Parent = parentPart
                table.insert(kitAdornments, box)
            end
        end
    end
end

