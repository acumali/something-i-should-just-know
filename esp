--------------------------------------------------------------------
-- 1. YOUR SHOCK / ELITE KIT ESP LOGIC
--------------------------------------------------------------------
local function adornEliteKit(descendant)
    if not state.EliteKitEspActive then return end
    if descendant.Name == "eliteicon" and descendant:IsA("BillboardGui") then
        local targetPart = descendant.Parent
        if targetPart and targetPart:IsA("BasePart") and not targetPart:FindFirstChild("ShockESP") then
            local kitModel = targetPart.Parent
            if kitModel then
                local isFirstKit = kitModel.Name:find("_kit1") and not kitModel.Name:find("_kit10")
                local kitColor = isFirstKit and Color3.fromRGB(0, 255, 0) or Color3.fromRGB(180, 0, 255)
                
                local b = Instance.new("BoxHandleAdornment")
                b.Name = "ShockESP"
                b.Adornee = targetPart
                b.AlwaysOnTop = true
                b.ZIndex = 10
                b.Size = targetPart.Size + Vector3.new(0.2, 0.2, 0.2)
                b.Color3 = kitColor
                b.Transparency = 0.5
                b.Parent = targetPart
            end
        end
    end
end

local function clearKitESP()
    for _, desc in ipairs(Workspace:GetDescendants()) do
        if desc:IsA("BasePart") then
            local adorn = desc:FindFirstChild("ShockESP")
            if adorn then adorn:Destroy() end
        end
    end
end

local function refreshKitESP()
    clearKitESP()
    if not state.EliteKitEspActive then return end
    
    for _, desc in ipairs(Workspace:GetDescendants()) do
        adornEliteKit(desc)
    end
end

-- Connect workspace listener for live spawning kits
Workspace.DescendantAdded:Connect(function(descendant)
    if state.EliteKitEspActive then
        adornEliteKit(descendant)
    end
end)

