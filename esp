local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local CoreGui = game:GetService("CoreGui")

local LocalPlayer = Players.LocalPlayer

-- GUI Container Protection
local function getGuiParent()
    if gethui then
        return gethui()
    elseif syn and syn.protect_gui then
        local gui = Instance.new("Folder")
        syn.protect_gui(gui)
        gui.Parent = CoreGui
        return gui
    else
        return CoreGui
    end
end

-- Toggle States
local playerEspEnabled = false
local kitAndHpEnabled = false

-- Element Tracking
local playerEspData = {} -- Stores Highlight, BillboardGui, Fill frame, and Humanoid
local kitAdornments = {}

--------------------------------------------------------------------
-- 1. LOCAL PLAYER HEALTH BAR GUI
--------------------------------------------------------------------
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "MinimalHealthHUD"
screenGui.ResetOnSpawn = false
screenGui.Enabled = false
screenGui.Parent = getGuiParent()

local frame = Instance.new("Frame")
frame.Size = UDim2.new(0, 220, 0, 22)
frame.Position = UDim2.new(0.5, -110, 0.85, 0)
frame.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
frame.BorderSizePixel = 0
frame.Parent = screenGui

local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 6)
corner.Parent = frame

local fill = Instance.new("Frame")
fill.Size = UDim2.new(1, -4, 1, -4)
fill.Position = UDim2.new(0, 2, 0, 2)
fill.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
fill.BorderSizePixel = 0
fill.Parent = frame

local fillCorner = Instance.new("UICorner")
fillCorner.CornerRadius = UDim.new(0, 4)
fillCorner.Parent = fill

local textLabel = Instance.new("TextLabel")
textLabel.Size = UDim2.new(1, 0, 1, 0)
textLabel.BackgroundTransparency = 1
textLabel.TextColor3 = Color3.fromRGB(0, 0, 0)
textLabel.TextScaled = true
textLabel.Font = Enum.Font.SourceSansBold
textLabel.Text = "100 / 100"
textLabel.Parent = frame

local function updateHealthBar()
    local char = LocalPlayer.Character
    if not char then return end
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if not humanoid then return end

    local hp = math.clamp(humanoid.Health, 0, humanoid.MaxHealth)
    local maxHp = humanoid.MaxHealth
    local ratio = maxHp > 0 and (hp / maxHp) or 0

    fill.Size = UDim2.new(ratio, -4, 1, -4)
    textLabel.Text = string.format("%d / %d", math.floor(hp), math.floor(maxHp))

    if ratio > 0.75 then
        fill.BackgroundColor3 = Color3.fromRGB(255, 255, 255) -- White
    elseif ratio > 0.50 then
        fill.BackgroundColor3 = Color3.fromRGB(255, 140, 0) -- Orange
    else
        fill.BackgroundColor3 = Color3.fromRGB(255, 50, 50)  -- Red
    end
end

--------------------------------------------------------------------
-- 2. PLAYER ESP & ENEMY MINI HP BAR
--------------------------------------------------------------------
local function clearPlayerESP()
    for _, data in pairs(playerEspData) do
        if data.Highlight and data.Highlight.Parent then
            data.Highlight:Destroy()
        end
        if data.Gui and data.Gui.Parent then
            data.Gui:Destroy()
        end
    end
    table.clear(playerEspData)
end

local function applyPlayerESP(player)
    if player == LocalPlayer then return end

    -- Team Check: Do not highlight teammates
    if player.Team and LocalPlayer.Team and player.Team == LocalPlayer.Team then
        return
    end

    local char = player.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if not humanoid then return end

    if playerEspData[char] then
        if playerEspData[char].Highlight then playerEspData[char].Highlight:Destroy() end
        if playerEspData[char].Gui then playerEspData[char].Gui:Destroy() end
    end

    -- Highlight Outline
    local highlight = Instance.new("Highlight")
    highlight.Name = "PlayerESP"
    highlight.Adornee = char
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.FillTransparency = 0.5
    highlight.OutlineTransparency = 0.2

    local classVal = char:FindFirstChild("class")
    local isElite = char:FindFirstChild("elitekit")
    local teamName = player.Team and player.Team.Name:lower() or ""

    if classVal and tostring(classVal.Value):lower() == "dread" then
        highlight.FillColor = Color3.fromRGB(255, 140, 0) -- Dread (Orange)
    elseif isElite then
        highlight.FillColor = Color3.fromRGB(0, 255, 0) -- Specialist (Green)
    elseif teamName:find("empire") then
        highlight.FillColor = Color3.fromRGB(255, 50, 50) -- Empire Team (Red)
    elseif teamName:find("nation") then
        highlight.FillColor = Color3.fromRGB(50, 150, 255) -- Nation Team (Blue)
    else
        highlight.FillColor = Color3.fromRGB(255, 0, 0) -- Standard Enemy (Red)
    end
    highlight.Parent = char

    -- Tiny Enemy HP Bar (BillboardGui above head)
    local head = char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
    local bgGui, fillBar
    if head then
        bgGui = Instance.new("BillboardGui")
        bgGui.Name = "EnemyHpBar"
        bgGui.Adornee = head
        bgGui.Size = UDim2.new(0, 36, 0, 5) -- Really small size
        bgGui.StudsOffset = Vector3.new(0, 2.2, 0)
        bgGui.AlwaysOnTop = true

        local bgFrame = Instance.new("Frame")
        bgFrame.Size = UDim2.new(1, 0, 1, 0)
        bgFrame.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
        bgFrame.BorderSizePixel = 0
        bgFrame.Parent = bgGui

        local bgCorner = Instance.new("UICorner")
        bgCorner.CornerRadius = UDim.new(0, 2)
        bgCorner.Parent = bgFrame

        fillBar = Instance.new("Frame")
        fillBar.Name = "Fill"
        fillBar.Size = UDim2.new(1, -2, 1, -2)
        fillBar.Position = UDim2.new(0, 1, 0, 1)
        fillBar.BackgroundColor3 = Color3.fromRGB(0, 255, 0)
        fillBar.BorderSizePixel = 0
        fillBar.Parent = bgFrame

        local fillCorner = Instance.new("UICorner")
        fillCorner.CornerRadius = UDim.new(0, 1)
        fillCorner.Parent = fillBar

        bgGui.Parent = getGuiParent()
    end

    playerEspData[char] = {
        Highlight = highlight,
        Gui = bgGui,
        Fill = fillBar,
        Humanoid = humanoid
    }
end

local function refreshPlayerESP()
    clearPlayerESP()
    if not playerEspEnabled then return end

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            applyPlayerESP(player)
        end
    end
end

--------------------------------------------------------------------
-- 3. SHOCK / ELITE KIT ESP
--------------------------------------------------------------------
local function clearKitESP()
    for _, adornment in pairs(kitAdornments) do
        if adornment and adornment.Parent then
            adornment:Destroy()
        end
    end
    table.clear(kitAdornments)
end

local function refreshKitESP()
    clearKitESP()
    if not kitAndHpEnabled then return end

    for _, desc in ipairs(Workspace:GetDescendants()) do
        if desc:IsA("BillboardGui") and desc.Name == "eliteicon" then
            local parentPart = desc.Parent
            if parentPart and parentPart:IsA("BasePart") then
                local box = Instance.new("BoxHandleAdornment")
                box.Name = "KitESP"
                box.Adornee = parentPart
                box.Size = parentPart.Size + Vector3.new(0.2, 0.2, 0.2)
                box.AlwaysOnTop = true
                box.ZIndex = 5
                box.Transparency = 0.4

                if parentPart.Name:lower():find("_kit1") then
                    box.Color3 = Color3.fromRGB(0, 255, 0) -- Kit 1 (Green)
                else
                    box.Color3 = Color3.fromRGB(170, 0, 255) -- Other Kits (Purple)
                end

                box.Parent = parentPart
                table.insert(kitAdornments, box)
            end
        end
    end
end

--------------------------------------------------------------------
-- 4. RENDERSTEPPED LOOP (LIVE UPDATES)
--------------------------------------------------------------------
RunService.RenderStepped:Connect(function()
    -- Update local health HUD if enabled
    if kitAndHpEnabled then
        updateHealthBar()
    end

    -- Update enemy mini HP bars in real-time
    if playerEspEnabled then
        for char, data in pairs(playerEspData) do
            if char and char.Parent and data.Humanoid and data.Humanoid.Parent then
                local hp = math.clamp(data.Humanoid.Health, 0, data.Humanoid.MaxHealth)
                local maxHp = data.Humanoid.MaxHealth
                local ratio = maxHp > 0 and (hp / maxHp) or 0

                data.Fill.Size = UDim2.new(ratio, -2, 1, -2)

                -- Color shift based on enemy HP percentage
                if ratio > 0.6 then
                    data.Fill.BackgroundColor3 = Color3.fromRGB(0, 255, 0)     -- Green
                elseif ratio > 0.3 then
                    data.Fill.BackgroundColor3 = Color3.fromRGB(255, 165, 0)  -- Orange
                else
                    data.Fill.BackgroundColor3 = Color3.fromRGB(255, 50, 50)   -- Red
                end
            else
                -- Clean up if target dies or leaves
                if data.Gui then data.Gui:Destroy() end
                if data.Highlight then data.Highlight:Destroy() end
                playerEspData[char] = nil
            end
        end
    end
end)

--------------------------------------------------------------------
-- 5. EVENT LISTENERS & KEYBINDS
--------------------------------------------------------------------
local function setupPlayerListeners(player)
    player.CharacterAdded:Connect(function()
        task.wait(0.5)
        if playerEspEnabled then applyPlayerESP(player) end
    end)
    player:GetPropertyChangedSignal("Team"):Connect(function()
        if playerEspEnabled then refreshPlayerESP() end
    end)
end

Players.PlayerAdded:Connect(setupPlayerListeners)
for _, player in ipairs(Players:GetPlayers()) do
    if player ~= LocalPlayer then
        setupPlayerListeners(player)
    end
end

LocalPlayer:GetPropertyChangedSignal("Team"):Connect(function()
    if playerEspStateChanged or playerEspEnabled then
        refreshPlayerESP()
    end
end)

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end

    -- "[" Key: Toggle Shock Kit ESP and Custom Local HP Bar
    if input.KeyCode == Enum.KeyCode.LeftBracket then
        kitAndHpEnabled = not kitAndHpEnabled
        screenGui.Enabled = kitAndHpEnabled
        refreshKitESP()
    end

    -- "]` Key: Toggle Player ESP + Enemy Mini HP Bars
    if input.KeyCode == Enum.KeyCode.RightBracket then
        playerEspEnabled = not playerEspEnabled
        refreshPlayerESP()
    end
end)
