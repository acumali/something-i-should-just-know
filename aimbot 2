    local oldProj; oldProj = clonefunction(hookfunction(rawget(bfuncs, targetFuncKey), newcclosure(function(self, ...))
        local args = {...};
        local origin = args[1] or (plr.Character and plr.Character.PrimaryPart.Position) or workspace.CurrentCamera.CFrame.Position;
