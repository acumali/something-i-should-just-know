-- 2. Hook __namecall to intercept Jolt Network Remotes (Crossbows & Thrown Weapons)
local oldNamecall
oldNamecall = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
    local method = getnamecallmethod()
    local args = {...}
    
    if (method == "FireServer" or method == "FireUnreliable" or method == "fireServer") then
        local remoteName = self.Name:lower()
        if remoteName:find("jolt") or remoteName:find("shoot") or remoteName:find("throw") or remoteName:find("fire") then
            local gun = plr.Character and plr.Character:FindFirstChildOfClass("Tool")
            local origin = cam.CFrame.Position
            local c = getTarget(origin)
            
            if c and gun then
                local gunName = gun.Name
                local speed = getWeaponSpeed(gunName)
                local predictedPos = predictTrajectory(origin, c, speed)
                local targetDir = (predictedPos - origin).Unit
                
                -- Replace Vector3 arguments inside the remote payload with our calculated trajectory
                for i, arg in ipairs(args) do
                    if typeof(arg) == "Vector3" then
                        args[i] = targetDir
                    elseif typeof(arg) == "CFrame" then
                        args[i] = CFrame.lookAt(arg.Position, predictedPos)
                    end
                end
                return oldNamecall(self, unpack(args))
            end
        end
    end
    
    return oldNamecall(self, ...)
end))

